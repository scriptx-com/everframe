{
  "name": "@everframe/bundler-plugin",
  "version": "0.0.0",
  "private": false,
  "description": "Bundler plugin that stamps an Everframe build identity into web bundles and uploads their source maps.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": {
    "./vite": { "types": "./dist/vite.d.ts", "default": "./dist/vite.js" },
    "./rollup": { "types": "./dist/rollup.d.ts", "default": "./dist/rollup.js" },
    "./webpack": { "types": "./dist/webpack.d.ts", "default": "./dist/webpack.js" },
    "./esbuild": { "types": "./dist/esbuild.d.ts", "default": "./dist/esbuild.js" },
    "./next": { "types": "./dist/next.d.ts", "default": "./dist/next.js" }
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json" },
  "dependencies": { "@everframe/cli": "workspace:^", "magic-string": "^0.30.0", "unplugin": "^2.3.0" },
  "devDependencies": { "@jridgewell/trace-mapping": "^0.3.25", "@types/node": "^22.0.0", "rollup": "^4.0.0", "tsup": "^8.0.0", "vite": "^6.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/scriptx-com/everframe.git", "directory": "packages/bundler-plugin" },
  "publishConfig": { "access": "public" }
}
