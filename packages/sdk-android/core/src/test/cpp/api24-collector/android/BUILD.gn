import("../../build/crashpad_buildconfig.gni")
declare_args() { everframe_crypto_root = "" }
assert(everframe_crypto_root != "")
crashpad_loadable_module("everframe_qualification_client") {
  output_name = "libeverframe_qualification_client"
  testonly = true
  sources = [ "client.cc", "handoff.cc" ]
  deps = [ "../../client", "../../util", "../../third_party/mini_chromium:base" ]
  libs = [ "log", "dl" ]
  ldflags = [ "-Wl,--build-id=sha1", "-static-libstdc++" ]
}
crashpad_loadable_module("everframe_qualification_handler") {
  output_name = "libeverframe_qualification_handler"
  testonly = true
  sources = [ "handler.cc", "handoff.cc", "../authority.cc", "../minimal_handler.cc", "../minimal_record.cc" ]
  include_dirs = [ "../", everframe_crypto_root + "/include" ]
  deps = [ "../../handler:handler", "../../snapshot", "../../util", "../../third_party/mini_chromium:base" ]
  libs = [ everframe_crypto_root + "/libcrypto.a", "log", "dl" ]
  ldflags = [ "-Wl,--build-id=sha1", "-Wl,--exclude-libs,ALL", "-static-libstdc++", "-Wl,--wrap=epoll_create1", "-Wl,--wrap=pthread_create" ]
}
crashpad_executable("everframe_qualification_trampoline") {
  testonly = true
  output_name = "libeverframe_qualification_trampoline.so"
  sources = [ "../../handler/linux/handler_trampoline.cc" ]
  deps = [ "../../util" ]
  libs = [ "log", "dl" ]
  ldflags = [ "-Wl,--build-id=sha1", "-static-libstdc++" ]
}
group("artifacts") {
  testonly = true
  deps = [ ":everframe_qualification_client", ":everframe_qualification_handler", ":everframe_qualification_trampoline" ]
}
