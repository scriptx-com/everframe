{
  "name": "@everframe/sdk-android",
  "private": true,
  "version": "1.2.0",
  "description": "Everframe native Android SDK workspace. The Gradle artifacts are not consumed through pnpm.",
  "license": "MIT",
  "scripts": {
    "build": "cd android && ./gradlew assembleRelease",
