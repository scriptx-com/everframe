<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-feature android:name="android.software.leanback" android:required="false"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <application android:name=".ProofApplication" android:label="Crash default acceptance" android:allowBackup="false"
  android:banner="@android:drawable/sym_def_app_icon" android:networkSecurityConfig="@xml/network_security_config">
  <activity android:name=".ProofActivity" android:exported="true">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="android.intent.category.LAUNCHER"/>
    <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
   </intent-filter>
  </activity>
 </application>
</manifest>
