{
  "name": "@traceitx/protocol",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas-json/envelope.v1.schema.json": "./schemas-json/envelope.v1.schema.json",
    "./schemas-json/relay.v1.schema.json": "./schemas-json/relay.v1.schema.json",
    "./schemas-json/vtree.v1.schema.json": "./schemas-json/vtree.v1.schema.json",
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "schemas-json",
    "data",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:publish": "attw --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm --exclude-entrypoints ./schemas-json/envelope.v1.schema.json ./schemas-json/relay.v1.schema.json ./schemas-json/vtree.v1.schema.json ./data/* && publint",
    "codegen": "node scripts/codegen-swift.mjs && node scripts/codegen-kotlin.mjs && node scripts/codegen-relay-swift.mjs && node scripts/codegen-relay-kotlin.mjs && node scripts/codegen-vtree-swift.mjs && node scripts/codegen-vtree-kotlin.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "ajv": "^8",
    "ajv-formats": "^3",
    "tsup": "^8.0.0"
  }
}
