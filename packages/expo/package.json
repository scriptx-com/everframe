{
  "name": "@everframe/expo",
  "version": "1.6.0",
  "private": false,
  "description": "Expo config plugin that collects and verifies Everframe build artifacts during native builds.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://everframe.dev",
  "bugs": {
    "url": "https://github.com/scriptx-com/everframe/issues"
  },
  "keywords": [
    "everframe",
    "expo",
    "expo-config-plugin",
    "react-native",
    "source-maps",
    "crash-reporting"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@everframe/cli": "workspace:^",
    "@expo/config-plugins": "^57.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scriptx-com/everframe.git",
    "directory": "packages/expo"
  },
  "publishConfig": {
    "access": "public"
  }
}
