{
  "extends": "./tsconfig.json",
  "include": ["src/**/*", "__tests__/**/*"],
  "compilerOptions": {
    "noEmit": true,
    // rootDir must contain every input in the program. "." suffices for the
    // other packages using this shape, but this package's tests import a
    // shared fixture from the repo root
    // (__tests__/proto-02-fixture.spec.tsx imports
    // fixtures/canonical/ui-tree/invariant-helpers/ts/assertParity.ts, a
    // canonical fixture shared with the Swift side), so it is widened to the
    // repo root here. This is the one exception in the round — pointing at
    // the repo root is the honest description of a test program that
    // genuinely spans the monorepo, not a workaround.
    "rootDir": "../..",
    // Relaxed for tests ONLY — src/ keeps both via tsconfig.json.
    // Measured on sdk-react, the largest suite: these two account for 89 of
    // the 109 errors that typechecking __tests__ surfaces, and none of the
    // real ones. `entries[0].foo` after expect(entries).toHaveLength(1) is
    // not a nullability bug, and a fixture literal with an explicit
    // `undefined` is not an exactOptionalPropertyTypes violation.
    //
    // packages/protocol and packages/sdk-core deliberately do NOT use this
    // file: they already typecheck their tests at FULL strictness via their
    // own tsconfig.json `include`, and moving them here would be a downgrade.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    // '@traceitx/sdk-core/conformance' is deliberately NOT a published
    // exports subpath (see packages/sdk-core/src/conformance/host-surface.ts's
    // header — it must stay out of the tsup-built artifact), so tsc has no
    // package.json entry to resolve it from. Mirror the vitest alias
    // (vitest.config.ts's resolve.alias) that points the SAME specifier at
    // SOURCE for the test runner, so `tsc -p tsconfig.test.json` can resolve
    // it too.
    "paths": {
      "@traceitx/sdk-core/conformance": ["../sdk-core/src/conformance/host-surface.ts"]
    }
  }
}
