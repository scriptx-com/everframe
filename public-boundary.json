{
  "publicPackages": [
    "@everframe/babel-plugin-displayname",
    "@everframe/bundler-plugin",
    "@everframe/cli",
    "@everframe/expo",
    "@everframe/identity",
    "@everframe/metro",
    "@everframe/protocol",
    "@everframe/react",
    "@everframe/react-native",
    "@everframe/roku",
    "@everframe/sdk-android",
    "@everframe/sdk-core",
    "@everframe/sdk-ios-marker",
    "@everframe/swc-plugin-displayname",
    "@everframe/web"
  ],
  "allowedTopLevel": [
    ".changeset",
    ".cursor-plugin",
    ".env.example",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".gitleaks.toml",
    ".gitleaksignore",
    ".npmrc",
    ".reuse",
    "brand-identity.json",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "Package.swift",
    "README.md",
    "REUSE.toml",
    "SECURITY.md",
    "docs",
    "examples",
    "package.json",
    "packages",
    "patches",
    "plugins",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "public-boundary.json",
    "scripts",
    "tsconfig.base.json",
    "turbo.json",
    "vitest.base.ts"
  ],
  "requiredPaths": [
    ".changeset/config.json",
    ".env.example",
    "REUSE.toml",
    "LICENSE",
    "LICENSES/Apache-2.0.txt",
    "LICENSES/MIT.txt",
    "vitest.base.ts",
    "examples/android-compose",
    "examples/android-views",
    "examples/compose-desktop-probe",
    "examples/flutter-web-probe",
    "examples/flutter-desktop-probe",
    "examples/flutter-android-probe",
    "examples/flutter-ios-probe",
    "examples/ios-native",
    "examples/macos-window-capture-probe",
    "examples/react-native",
    "examples/react-tv-sample",
    "examples/react-web",
    "examples/roku-channel",
    "examples/smarttv-tester",
    "examples/tvos-replay",
    "examples/vue-web",
    "packages/babel-plugin-displayname/package.json",
    "packages/bundler-plugin/package.json",
    "packages/cli/package.json",
    "packages/everframe_flutter/pubspec.yaml",
    "packages/expo/package.json",
    "packages/identity/package.json",
    "packages/metro/package.json",
    "packages/protocol/package.json",
    "packages/sdk-android/package.json",
    "packages/sdk-core/package.json",
    "packages/sdk-ios/package.json",
    "packages/sdk-react-native/package.json",
    "packages/sdk-react/package.json",
    "packages/sdk-roku/package.json",
    "packages/sdk-web/package.json",
    "packages/swc-plugin-displayname/package.json",
    "patches/@expo__cli@56.1.0.patch",
    "patches/@noble__hashes@1.8.0.patch",
    "patches/modern-screenshot@4.7.0.patch",
    "patches/rrweb@2.0.1.patch",
    "patches/zod@4.3.6.patch"
  ],
  "forbiddenPathPatterns": [
    "(^|/)apps/",
    "examples/tvos-replay/scripts/(benchmark|companion|dashboard|drive-xctest|verify-recording)\\.mjs$"
  ],
  "ignoredPathPatterns": [
    "^\\.superpowers/",
    "^examples/flutter-web-probe/\\.dart_tool/",
    "^examples/flutter-web-probe/pubspec\\.lock$",
    "^examples/flutter-desktop-probe/\\.dart_tool/",
    "^examples/flutter-desktop-probe/\\.idea/",
    "^examples/flutter-desktop-probe/\\.metadata$",
    "^examples/flutter-desktop-probe/pubspec\\.lock$",
    "^examples/flutter-desktop-probe/macos/Flutter/(?:ephemeral/|GeneratedPluginRegistrant\\.swift$)",
    "^examples/flutter-desktop-probe/macos/Pods/",
    "^examples/flutter-android-probe/\\.dart_tool/",
    "^examples/flutter-android-probe/\\.idea/",
    "^examples/flutter-android-probe/\\.metadata$",
    "^examples/flutter-android-probe/pubspec\\.lock$",
    "^examples/flutter-android-probe/android/\\.gradle/",
    "^examples/flutter-android-probe/android/local\\.properties$",
    "^examples/flutter-android-probe/android/gradlew(?:\\.bat)?$",
    "^examples/flutter-android-probe/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant\\.java$",
    "^examples/flutter-ios-probe/\\.dart_tool/",
    "^examples/flutter-ios-probe/\\.idea/",
    "^examples/flutter-ios-probe/\\.metadata$",
    "^examples/flutter-ios-probe/pubspec\\.lock$",
    "^examples/flutter-ios-probe/ios/Flutter/ephemeral/",
    "^examples/flutter-ios-probe/ios/Flutter/Generated\\.xcconfig$",
    "^examples/flutter-ios-probe/ios/Flutter/flutter_export_environment\\.sh$",
    "^examples/flutter-ios-probe/ios/Pods/",
    "^examples/flutter-ios-probe/ios/\\.symlinks/",
    "^examples/flutter-ios-probe/ios/Runner/GeneratedPluginRegistrant\\.(?:h|m|swift)$",
    "^examples/compose-desktop-probe/\\.gradle/",
    "^examples/compose-desktop-probe/\\.kotlin/",
    "^examples/compose-desktop-probe/\\.idea/",
    "^packages/everframe_flutter/\\.dart_tool/",
    "^packages/everframe_flutter/pubspec\\.lock$",
    "^packages/sdk-web/test-results/",
    "(^|/)\\.gradle(?:/|$)",
    "^packages/sdk-android/tests/native-release-host/app/\\.cxx(?:/|$)",
    "(^|/)(?:node_modules|dist|build|target|\\.turbo|\\.next|\\.build|DerivedData)(?:/|$)",
    "(^|/)next-env\\.d\\.ts$",
    "(^|/)examples/react-native/(?:android|ios)(?:/|$)",
    "(^|/)examples/tvos-replay/ReplayTV\\.xcodeproj(?:/|$)",
    "(^|/)packages/sdk-android/android/\\.gradle(?:/|$)",
    "^packages/sdk-ios/dev-podspec/Everframe(?:Kit|Protocol|ReporterUI)\\.xcframework$"
  ],
  "forbiddenTextPatterns": [
    {
      "pattern": "@everframe/(admin|api|brand-ui|reporter-surface|source-maps)",
      "reason": "out-of-scope package reference"
    },
    {
      "pattern": "apps/(api|admin|ingest-service|reporter)",
      "reason": "out-of-scope application path"
    },
    {
      "pattern": "(\\.planning/|docs/superpowers/)",
      "reason": "out-of-scope planning artifact"
    },
    {
      "pattern": "~/mware/",
      "reason": "developer-local repository path"
    },
    {
      "pattern": "mware(tv|/|-)",
      "flags": "i",
      "reason": "unrelated customer or product reference"
    },
    {
      "pattern": "REPLAY_ADMIN_(EMAIL|PASSWORD)",
      "reason": "admin credential reference"
    },
    {
      "pattern": "github\\.com/scriptx/everframe(?:\\.git|/|\\)|$)",
      "reason": "unrelated repository URL"
    }
  ],
  "envTemplates": [
    ".env.example"
  ],
  "license": {
    "ownedExtensions": [
      ".c",
      ".cjs",
      ".css",
      ".dart",
      ".example",
      ".gradle",
      ".h",
      ".html",
      ".java",
      ".js",
      ".jsx",
      ".kt",
      ".kts",
      ".lock",
      ".md",
      ".mjs",
      ".mm",
      ".pbxproj",
      ".plist",
      ".podspec",
      ".pro",
      ".properties",
      ".py",
      ".rb",
      ".rs",
      ".sh",
      ".swift",
      ".ts",
      ".tsx",
      ".vue",
      ".xcconfig",
      ".xcprivacy",
      ".xcscheme",
      ".xcworkspacedata",
      ".xml",
      ".yaml",
      ".yml"
    ],
    "upstream": [
      {
        "pathPattern": "(^|/)gradlew$",
        "spdx": "Apache-2.0"
      },
      {
        "pathPattern": "(^|/)gradlew\\.bat$",
        "spdx": "Apache-2.0"
      },
      {
        "pathPattern": "(^|/)gradle/wrapper/gradle-wrapper\\.properties$",
        "spdx": "Apache-2.0"
      },
      {
        "pathPattern": "^packages/sdk-ios/crash-recorder/Sources/EverframeCrashRecorder/Vendor/KSCrashRecordingCore/KSObjCApple\\.h$",
        "spdx": "APSL-2.0"
      },
      {
        "pathPattern": "^packages/sdk-ios/crash-recorder/Sources/EverframeCrashRecorder/Vendor/KSCrashRecordingCore/KSMach-O\\.c$",
        "spdx": "MIT AND APSL-2.0"
      },
      {
        "pathPattern": "^packages/sdk-ios/crash-recorder/Sources/EverframeCrashRecorder/Vendor/KSCrashRecordingCore/KSCxaThrowSwapper\\.c$",
        "spdx": "MIT AND BSD-3-Clause"
      }
    ],
    "exemptPathPatterns": [
      "(^|/)(?:SampleApp|Everframe|KmpIosProbes)\\.xcodeproj/(?:project\\.pbxproj|project\\.xcworkspace/contents\\.xcworkspacedata|xcshareddata/xcschemes/[^/]+\\.xcscheme)$",
      "^examples/kmp-ios-probes/Kmp(?:NativeProbe|ComposeHost)-Info\\.plist$",
      "^packages/cli/__tests__/fixtures/ios/project\\.pbxproj$"
    ]
  }
}
