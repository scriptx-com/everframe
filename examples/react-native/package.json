{
  "name": "examples-react-native",
  "version": "0.0.11",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --clean --platform ios",
    "prebuild:android": "expo prebuild --clean --platform android",
    "prebuild:tv-ios": "EXPO_TV=1 expo prebuild --clean --platform=ios --no-install",
    "prebuild:tv-android": "EXPO_TV=1 expo prebuild --clean --platform=android --no-install",
    "sync-env": "node scripts/sync-env.mjs",
    "start": "node scripts/sync-env.mjs && node scripts/with-free-port.mjs expo start",
    "ios": "node scripts/sync-env.mjs && node scripts/with-free-port.mjs expo run:ios",
    "android": "node scripts/sync-env.mjs && node scripts/with-free-port.mjs expo run:android",
    "ios:tv": "EXPO_TV=1 node scripts/sync-env.mjs && EXPO_TV=1 node scripts/with-free-port.mjs expo run:ios",
    "android:tv": "EXPO_TV=1 node scripts/sync-env.mjs && EXPO_TV=1 node scripts/with-free-port.mjs expo run:android",
    "typecheck": "tsc --noEmit",
    "maestro:smoke": "maestro test maestro/reporter-smoke.yaml"
  },
  "dependencies": {
    "@react-native-tvos/config-tv": "0.1.6",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@everframe/react-native": "workspace:*",
    "expo": "56.0.0-preview.7",
    "expo-build-properties": "58.0.4",
    "react": "19.2.5",
    "react-native": "npm:react-native-tvos@0.85.3-0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.5.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.14.0",
    "react-native-video": "7.0.0-beta.11"
  },
  "devDependencies": {
    "@everframe/babel-plugin-displayname": "workspace:*",
    "@types/react": "^19.1.1",
    "react-dom": "19.2.5",
    "typescript": "~5.9.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-safe-area-context"
        ]
      },
      "searchPaths": [
        "../../packages"
      ]
    }
  }
}
