{
  "expo": {
    "name": "Everframe RN Example",
    "slug": "examplereactnative",
    "version": "0.0.0",
    "scheme": "everframeexample",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.everframe.example",
      "supportsTablet": true,
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "dev.everframe.example"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "@react-native-tvos/config-tv",
        { "tvosDeploymentTarget": "16.4" }
      ],
      "./plugins/with-everframe-workspace.js",
      "./plugins/with-everframe-tv-prebuild.js",
      "./plugins/with-everframe-ios-local.js"
    ]
  }
}
