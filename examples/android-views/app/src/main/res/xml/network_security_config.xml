<!-- Localhost-only cleartext exception — mirrors iOS's NSAllowsLocalNetworking.
     Required for the sample's dev loop against http://10.0.2.2:8787 (the
     Android emulator's alias for the host's localhost). Production hosts on
     real ingest URLs must use https:// — TraceItXConfig's ConfigValidator
     enforces that for `Environment.production`. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 10.0.2.2 = Android emulator's host loopback alias.
             10.0.3.2 = Genymotion emulator equivalent. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
