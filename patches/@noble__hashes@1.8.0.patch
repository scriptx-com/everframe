         // So we just write lowest 64 bits of that value.
-        setBigUint64(view, blockLen - 8, BigInt(this.length * 8), isLE);
+        // Length is already a JS number. Write its low 64 bits without BigInt,
+        // which is absent on older TV engines (SHA-256/HMAC use this path).
+        const bitLength = this.length * 8;
+        const high = Math.floor(bitLength / 0x100000000);
+        const low = bitLength >>> 0;
+        view.setUint32(blockLen - 8, isLE ? low : high, isLE);
+        view.setUint32(blockLen - 4, isLE ? high : low, isLE);
         this.process(view, 0);
         const oview = (0, utils_ts_1.createView)(out);
         const len = this.outputLen;
